# Prelo · configuração (copie para .env; os scripts iniciar.* fazem isso e geram as senhas)

# Porta no navegador
APP_PORT=8080

# Banco: postgresql | mysql | sqlserver | oracle (os dois valores precisam ser iguais)
DB_VENDOR=postgresql
COMPOSE_PROFILES=postgresql

DB_NAME=prelo
DB_USER=prelo
# Gerada pelos scripts. No SQL Server ela também vira a senha do usuário sa:
# precisa ter letras maiúsculas, minúsculas e números.
DB_PASSWORD=

# Chave do JWT (mínimo 32 caracteres). Gerada pelos scripts; nunca publique a sua.
JWT_SECRET=

# Contas, livros e pedidos de exemplo num banco vazio
APP_SEED_DEMO=true
# Pagamentos simulados (cartões de teste, Pix e boleto confirmados por botão)
PAYMENTS_SANDBOX=true

# Atrás de um proxy com HTTPS: true (cookie de sessão só por HTTPS)
APP_HTTPS=false
APP_CORS_ORIGINS=http://localhost:8080
API_DOCS_ENABLED=true
